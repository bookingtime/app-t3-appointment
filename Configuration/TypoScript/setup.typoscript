######################
# Frontend Plugin ####
######################
plugin.tx_appointment {
	view {
		templateRootPaths {
			0 = EXT:bt_appointment/Resources/Private/Templates/
			1 = {$plugin.tx_appointment.view.templateRootPath}
		}
		partialRootPaths {
			0 = EXT:bt_appointment/Resources/Private/Partials/
			1 = {$plugin.tx_appointment.view.partialRootPath}
		}
		layoutRootPaths {
			0 = EXT:bt_appointment/Resources/Private/Layouts/
			1 = {$plugin.tx_appointment.view.layoutRootPath}
		}
	}

	persistence {
		storagePid = {$plugin.tx_appointment.settings.pid}
		recursive = 99
	}

	settings {
		pid = {$plugin.tx_appointment.settings.pid}
	}
}


####################
# Backend Modul ####
####################
module.tx_appointment {
    # view-Pfade nur fuer TYPO3 11 noetig: ab v12 kommen sie aus der
    # Modul-Registrierung (Configuration/Backend/Modules.php)
    view {
        templateRootPaths.0 = EXT:bt_appointment/Resources/Private/Templates/
        partialRootPaths.0 = EXT:bt_appointment/Resources/Private/Partials/
        layoutRootPaths.0 = EXT:bt_appointment/Resources/Private/Layouts/
    }

    persistence {
        storagePid = {$plugin.tx_appointment.settings.pid}
        recursive = 99
    }
	settings {
		pid = {$plugin.tx_appointment.settings.pid}
	}
}
